# jq-linux-amd64
_GH_URL=${GH_PXY}https://api.github.com/repos/jqlang/jq/releases/latest
_GH_FIL=$(curl -L -s -H "Authorization: token $GH_TKN" "$_GH_URL" \
  | jq -r '.assets[]
  | select(.name | test("linux.*amd64";"i"))
  | .browser_download_url')
_GH_FIL="${_GH_FIL#${GH_PXY}}"
echo $_GH_FIL
curl -L -o jq $_GH_FIL
install -Dm 755 jq -T $LOCAL_BIN/jq
rm jq
jq --version

# https://www.passwordstore.org
# https://github.com/zx2c4/password-store
{{ $sudo }}apt-get install -y pass

