{{- if eq .osid "linux-debian" -}}
#!/usr/bin/env bash
set -euo pipefail

echo "[Script] run_onchange_before_0001.sh.tmpl"

command_exists() {
	command -v "$@" >/dev/null 2>&1
}

is_linux() {
	[[ "$(uname -s)" == "Linux" ]]
}

is-debian() {
	[[ -f /etc/os-release ]] && grep -qi '^ID=debian' /etc/os-release
}

{{- $sudo := "" }}
{{- if ne .chezmoi.username "root" }}
{{- $sudo = "sudo " }}
{{- end }}

