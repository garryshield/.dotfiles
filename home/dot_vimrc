" =========================
" 基础设置
" =========================
set nocompatible            " 禁用 vi 兼容模式
set encoding=utf-8          " 内部编码 UTF-8
syntax on                   " 开启语法高亮
set ruler                   " 状态栏显示光标位置
set mouse=a                 " 启用鼠标支持

" =========================
" 文件与备份
" =========================
set nobackup                " 不生成备份文件
set noswapfile              " 不生成 swap 文件

" =========================
" 缩进与制表符
" =========================
set tabstop=2               " Tab 显示为 2 空格
set shiftwidth=2            " 缩进宽度 2 空格
set expandtab               " Tab 转为空格
set autoindent              " 自动继承上一行缩进
set smartindent             " 智能缩进
set copyindent              " 复制上一行缩进格式

" =========================
" 搜索与匹配
" =========================
set hlsearch                " 高亮搜索结果
set showmatch               " 高亮匹配括号
set smartcase               " 包含大写时区分大小写

" =========================
" 界面显示
" =========================
set number                  " 显示绝对行号
set laststatus=2            " 始终显示状态栏
