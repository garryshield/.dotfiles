#!/usr/bin/env bun

// @ts-nocheck

/*
# 前景色： \033[38;2;R;G;Bm
# 背景色： \033[48;2;R;G;Bm
# R = 0-255
# G = 0-255
# B = 0-255
*/

import { $ } from "bun";
import chalk from "chalk";

// const cols = (await $`tput cols`.text()) * 1;
const cols = process.stdout.columns;
const width = Math.floor(cols / 4);
const height = width;

const toHex = (x) => x.toString(16).padStart(2, "0");

for (let y = 0; y < height; y++) {
  y > 0 && console.log("");
  for (let x = 0; x < width; x++) {
    // 色相 0 ~ 360
    const hue = (x / width) * 360;
    // 饱和度 0 ~ 100
    const saturation = 100;
    // 亮到 0 ~ 100
    const lightness = 100 - (y / height) * 100;

    const hsl_str = `hsl(${hue},${saturation}%,${lightness}%)`;
    const { r, g, b } = Bun.color(hsl_str, "{rgb}");
    const hex = `#${toHex(r)}${toHex(g)}${toHex(b)}`;

    const text = chalk.bgHex(hex).hex(hex)("  ");
    process.stdout.write(text);
  }
}
console.log("");
