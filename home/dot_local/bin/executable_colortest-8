#!/usr/bin/env bash

# https://en.wikipedia.org/wiki/ANSI_escape_code
# https://tldp.org/HOWTO/Bash-Prompt-HOWTO/x329.html

# 前景色： \033[<FG>m
# 背景色： \033[<BG>m
# FG = 30–37
# BG = 40-47

# ansi-8 3-bit ANSI
# FG     BG     NAME
# 30     40     Black
# 31     41     Red
# 32     42     Green
# 33     43     Yellow
# 34     44     Blue
# 35     45     Magenta
# 36     46     Cyan
# 37     47     White

# ansi-16 4-bit Bright-ANSI
# FG    BG      NAME
# 90    100     Bright Black
# 91    101     Bright Red
# 92    102     Bright Green
# 93    103     Bright Yellow
# 94    104     Bright Blue
# 95    105     Bright Magenta
# 96    106     Bright Cyan
# 97    107     Bright White

# ansi-256 8-bit
# 0-7           ANSI
# 8-15          Bright-ANSI
# 16-231        6*6*6=216 16+36*r+6*g+b (0≤r,g,b≤5)
# 232-255       Grayscale dark to light in 24 steps

# ansi-16m 8-bit 24-bit True-Color

TXT='xxx'
BGS=(40m 41m 42m 43m 44m 45m 46m 47m)
FGS=(
    'm' '1m'
    '30m' '1;30m'
    '31m' '1;31m'
    '32m' '1;32m'
    '33m' '1;33m'
    '34m' '1;34m'
    '35m' '1;35m'
    '36m' '1;36m'
    '37m' '1;37m'
)

# 计算长度
TXT_LEN=${#TXT}
BGS_LEN=4
FGS_LEN=5
# 填充长度
PAD_LEN=1
# 项目长度
ITM_LEN=$((TXT_LEN + 2 * PAD_LEN))

TXT_NEW=$(printf "%*s%s%*s" $PAD_LEN "" $TXT $PAD_LEN "")

# 第一行
echo
printf "%${FGS_LEN}s" ""
printf " "
printf "%${ITM_LEN}s" ""
for BG in "${BGS[@]}"; do
    printf " "
    printf "%*s%s%*s" "$PAD_LEN" "" "$BG" "$((ITM_LEN - PAD_LEN - ${#BG}))" ""
done
echo

# 循环前景色和背景色组合
for ITM in "${FGS[@]}"; do
    FG=${ITM// /} # 去除空格
    # 第一列
    printf "%*s%s" $((FGS_LEN - ${#FG})) "" "$FG"
    printf " "
    # 第三列
    printf "\033[%s%s\033[0m" "$FG" "$TXT_NEW"
    for BG in "${BGS[@]}"; do
        printf " "
        printf "\033[%s\033[%s%s\033[0m" "$FG" "$BG" "$TXT_NEW"
    done
    echo
done
echo
